rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User Profiles — private by default, public fields exposed via query
    match /users/{userId} {
      // Only the owner can read their own full profile
      allow read: if isOwner(userId);
      // Create: owner only, cannot self-assign rating or createdAt
      allow create: if isOwner(userId)
        && !request.resource.data.keys().hasAny(['rating'])
        && request.resource.data.email is string;
      // Update: owner can only modify safe fields, not rating/role/createdAt
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'emotionTags', 'status', 'photoUrl', 'fcmToken', 'tokenUpdatedAt']);
      // Soft-delete only (mark inactive), hard delete forbidden
      allow delete: if false;
    }

    // Public listener discovery (anonymized — no email/uid exposed)
    match /publicListeners/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['displayName', 'emotionTags', 'status', 'rating']);
    }

    // Chat Sessions — creation restricted to Cloud Functions (Admin SDK)
    match /sessions/{sessionId} {
      // Participants can read their own sessions
      allow read: if isAuthenticated() &&
        (resource.data.seekerId == request.auth.uid ||
         resource.data.giverId == request.auth.uid);
      // Only Cloud Functions (admin) create sessions
      allow create: if false;
      // Participants can update only status and identityRevealed fields
      allow update: if isAuthenticated() &&
        (resource.data.seekerId == request.auth.uid ||
         resource.data.giverId == request.auth.uid) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'identityRevealed']);
      allow delete: if false;

      match /messages/{messageId} {
        // Only session participants can read messages
        allow read: if isAuthenticated() &&
          (get(/databases/$(database)/documents/sessions/$(sessionId)).data.seekerId == request.auth.uid ||
           get(/databases/$(database)/documents/sessions/$(sessionId)).data.giverId == request.auth.uid);
        // Only session participants can send; sender must be themselves; text bounded
        allow create: if isAuthenticated() &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 2000 &&
          request.resource.data.timestamp is int &&
          (get(/databases/$(database)/documents/sessions/$(sessionId)).data.seekerId == request.auth.uid ||
           get(/databases/$(database)/documents/sessions/$(sessionId)).data.giverId == request.auth.uid);
        allow update, delete: if false;
      }
    }

    // Reports — write-once by authenticated user; admin-read only
    match /reports/{reportId} {
      allow create: if isAuthenticated()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reportedUserId is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 500;
      allow read, update, delete: if false;
    }
  }
}
